# Copy this file to server/.env and fill in real values.
# Never commit the actual .env file — this is where secret keys live.

PORT=3000

# Which AI provider the /api/ai-assistant endpoint uses: "anthropic" or "openai"
AI_PROVIDER=anthropic

# Only one of these is needed, matching AI_PROVIDER above
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
